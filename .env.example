# Seedup Supabase Configuration
# Find these values in the Supabase dashboard under Settings > API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only key. It bypasses Row Level Security, so never add a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_your-key

# OpenRouter
OPENROUTER_API_KEY=your-openrouter-api-key
# Free models for testing. Free model availability changes, so check openrouter.ai/models.
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_FALLBACK_MODELS=recursive/flint-v1.0:free,openrouter/free
# Free models that write PRDs, best first. Defaults to ernie 5.5 flash, then nemotron ultra (see lib/opportunities/llm.ts).
# PRD_FREE_MODELS=baidu/ernie-5.5-flash-preview:free,particle-ai/particle-1:free,nvidia/nemotron-3-ultra-550b-a55b:free
# true blocks every paid model, including embeddings. Remove it for production.
OPENROUTER_FREE_ONLY=true
# Paid models for production:
# OPENROUTER_MODEL=anthropic/claude-sonnet-5
# OPENROUTER_FALLBACK_MODELS=google/gemini-3.5-flash
# Optional comma-separated preprocessing models. Defaults to google/gemini-3.5-flash.
# When OPENROUTER_MODEL is a free model, preprocessing uses the free models above instead.
# OPENROUTER_PREPROCESS_MODELS=google/gemini-3.5-flash
# OpenRouter embedding model used by the Supabase pgvector RAG index. Vectors are cut to 1536 dimensions.
# After changing it, run `npx tsx --env-file=.env scripts/reembed.ts`: vectors from two models cannot be compared.
RAG_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# Paid embedding model for production:
# RAG_EMBEDDING_MODEL=openai/text-embedding-3-small
NEXT_PUBLIC_SITE_URL=http://localhost:3000
GITHUB_TOKEN=github_pat_or_token
GITHUB_MIN_STARS=50
HUGGINGFACE_TOKEN=
STACKEXCHANGE_KEY=
INGEST_SECRET=change-this-secret
# Optional second secret accepted by the ingest API, for example from a scheduler.
# CRON_SECRET=
ADMIN_EMAILS=you@example.com
# When the daily AI limit check itself fails (missing SQL, DB outage): blocked in production, allowed locally.
# Set true or false to override.
# USAGE_LIMIT_FAIL_OPEN=

# Email newsletter sender
RESEND_API_KEY=your-resend-api-key
NEWSLETTER_FROM_EMAIL="Seedup <newsletter@your-domain.com>"

# Cloudflare deployment
# After deployment, set this to your workers.dev URL or custom domain.
# NEXT_PUBLIC_SITE_URL=https://seedup-ver2.your-subdomain.workers.dev
MAX_ITEMS_PER_SOURCE=10
INGEST_RSS_SOURCES="IT동아|https://it.donga.com/feeds/rss/|ko
전자신문|http://rss.etnews.com/03.xml|ko
