Stack Overflow Kubernetes|https://api.stackexchange.com/2.3/questions?order=desc&sort=activity&tagged=kubernetes&site=stackoverflow&pagesize=25|en"
INGEST_HACKERNEWS_SOURCES="HN Search AI Agent|https://hn.algolia.com/api/v1/search_by_date?query=ai%20agent&tags=story|en
HN Search MCP|https://hn.algolia.com/api/v1/search_by_date?query=mcp&tags=story|en
HN Search RAG|https://hn.algolia.com/api/v1/search_by_date?query=rag&tags=story|en
HN Search Claude Code|https://hn.algolia.com/api/v1/search_by_date?query=claude%20code&tags=story|en
HN Search Backend|https://hn.algolia.com/api/v1/search_by_date?query=postgres%20kubernetes&tags=story|en"

# Seedup additions
# Added environment variables are kept in this section at the end of the file.
OPENROUTER_TIMEOUT_MS=45000
OPENROUTER_ARTICLE_TIMEOUT_MS=75000
# Uses OPENROUTER_API_KEY above to collect OpenRouter model usage and benchmark rankings.
INGEST_OPENROUTER_MODEL_LIMIT=20
# RSS items older than this many days are ignored during normal collection.
RSS_RECENT_WINDOW_DAYS=7
# Optional: URL used by admin server actions to call the local ingest API.
# INGEST_INTERNAL_URL=http://localhost:3000
# Optional: web search for the opportunity engine (competitor research first, then more quotes). Free tier at tavily.com.
# Without it the engine searches only GitHub, HN, Stack Exchange, npm, VS Code and the App Store.
TAVILY_API_KEY=
# 검증 리포트에서 모델이 검색어를 바꿔 경쟁 도구를 최대 2번 더 찾습니다(on/off, 기본 off). 같은 20건으로 비교한 뒤 켭니다.
RIVAL_AGENT=
# Optional: model for the engine's evidence top-up. The free models often answer empty there; "exaone" uses EXAONE_API_KEY.
# ENGINE_EVIDENCE_MODEL=exaone
# Optional: posts the engine reads per run (default 540) and below-bar problems it searches per run (default 20).
# ENGINE_SAMPLE_LIMIT=540
# ENGINE_TOPUP_LIMIT=20

# Optional: key that signs quotes found by the web evidence search (falls back to SUPABASE_SECRET_KEY).
LIVE_EVIDENCE_SECRET=

# Optional: key that signs personal MCP tokens. 없으면 SUPABASE_SECRET_KEY를 씁니다. 한번 정하면 바꾸지 마세요(바꾸면 기존 MCP 연결이 끊김).
MCP_TOKEN_SECRET=
# Optional: also search low-star App Store reviews for ideas outside software. Off until reuse rights for Apple's
# review feed are confirmed (plan 3-10): a kept review sentence is stored in PRDs and the shared quote store.
# APP_REVIEW_EVIDENCE=true
