{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seedup-ver2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "seedup.rerereally.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": {
    "region" : "aws:us-east-1"
  },
  // Per-visitor request limits used by lib/throttle.ts, one binding per limit (RL_<requests per minute>). Counted
  // across Worker instances in each Cloudflare location; the namespace ids only need to be unique in this account.
  "ratelimits": [
    { "name": "RL_60", "namespace_id": "1060", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_30", "namespace_id": "1030", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_12", "namespace_id": "1012", "simple": { "limit": 12, "period": 60 } },
    { "name": "RL_8", "namespace_id": "1008", "simple": { "limit": 8, "period": 60 } },
    { "name": "RL_6", "namespace_id": "1006", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_1", "namespace_id": "1001", "simple": { "limit": 1, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      // Fetch invocation logs include the full URL, and some MCP clients carry their connection token in its path.
      "invocation_logs": false
    }
  }
}
